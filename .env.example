# Modèle de configuration. Copier vers `.env` (jamais versionné) et remplir.
# Chargé par Gestion_edt/settings.py via django-environ ; une variable
# d'environnement réelle l'emporte sur le fichier.

# ── Mode ─────────────────────────────────────────────────────────────────────
# True uniquement sur un poste de développement. Par défaut : False (production).
DJANGO_DEBUG=False

# Actif par défaut hors debug. À mettre à False uniquement pour une démo derrière
# un tunnel qui ne transmet pas X-Forwarded-Proto (sinon boucle de redirection).
# DJANGO_HTTPS=True

# ── Secrets ──────────────────────────────────────────────────────────────────
# Obligatoire hors debug. Générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Elle signe aussi les jetons JWT : la changer déconnecte tout le monde.
DJANGO_SECRET_KEY=

# ── Base de données (compte MySQL dédié, jamais root) ────────────────────────
DB_NAME=edt_uccb
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ── Réseau ───────────────────────────────────────────────────────────────────
# Listes séparées par des virgules.
DJANGO_ALLOWED_HOSTS=edt.exemple-universite.org
DJANGO_CORS_ALLOWED_ORIGINS=https://edt.exemple-universite.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://edt.exemple-universite.org

# HSTS : commencer bas (3600 = 1 h) puis monter à 31536000 (1 an) une fois HTTPS stable.
# DJANGO_HSTS_SECONDS=3600

# Nombre de reverse proxies devant Django (Nginx = 1). Sert à identifier
# l'adresse réelle du client pour la limitation des tentatives de connexion.
# Défaut : 1 en production (HTTPS), 0 en développement.
# DJANGO_NUM_PROXIES=1

# ── Fichiers, cache et journaux (facultatif) ─────────────────────────────────
# DJANGO_MEDIA_ROOT=/var/lib/edt/media
# Préfixe Nginx `internal` qui sert les documents après contrôle des droits par
# Django (X-Accel-Redirect). Vide = Django envoie lui-même le fichier (dev).
# DJANGO_PROTECTED_MEDIA_PREFIX=/protected_media/
# DJANGO_CACHE_DIR=/var/cache/edt
# DJANGO_LOG_DIR=/var/log/edt

# ── seed.py (développement uniquement) ───────────────────────────────────────
# Mot de passe commun des comptes générés. Vide = aléatoire, affiché une fois.
# SEED_PASSWORD=
